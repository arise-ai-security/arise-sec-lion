    "justification": {
      "parent_task": "Reproduce CVE-2023-2838 in gpac",
      "split_reason": "Patch generation requires understanding from exploitation phase",
      "objective": "Create minimal patch that prevents out-of-bounds read",
      "plan": "Validate loop bound against actual list size, rebuild, re-run PoC",
      "why_it_may_work": "Bug report identifies exact location and root cause",
      "expected_results": "Patched binary runs PoC without ASan error",
      "budget_allocation": "45%",
      "complexity_assessment": "MODERATE: Requires code analysis and validation",
      "significance_weight": "CRITICAL: Final deliverable",
