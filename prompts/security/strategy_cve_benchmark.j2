    "justification": {
      "parent_task": "Reproduce CVE-2023-2838 in gpac",
      "split_reason": "PoC execution requires built binary from BuilderAgent",
      "objective": "Confirm vulnerability triggers with provided PoC",
      "plan": "Download crash file, execute MP4Box with -dash flag, capture ASan output",
      "why_it_may_work": "Bug report includes exact command and expected output",
      "expected_results": "ASan SEGV at filter_session.c:4149 in gf_filter_get_stats",
      "budget_allocation": "30%",
      "complexity_assessment": "SIMPLE: Execute known PoC command",
      "significance_weight": "HIGH: Validates vulnerability existence",
      "resource_justification": "30% for PoC execution and output analysis"
    },
    "config": {
      "strategy": "heuristic",
      "base": {"model": "o3", "temperature": 0.5, "max_tokens": 4000},
      "tool": "claude_code"
    },
    "budget_weight": 1.2
  },
