      "why_it_may_work": "Dockerfile tested, build.sh contains correct flags",
      "expected_results": "Docker container with MP4Box binary compiled with ASan",
      "budget_allocation": "25%",
      "complexity_assessment": "SIMPLE: Standard Docker build with provided scripts",
      "significance_weight": "CRITICAL PATH: Blocking dependency",
      "resource_justification": "25% for straightforward build task"
    },
    "config": {
      "strategy": "heuristic",
      "base": {"model": "o3-mini", "temperature": 0.3, "max_tokens": 4000},
