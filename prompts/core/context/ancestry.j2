{# Ancestry chain template for AncestryChain #}
{# Renders full lineage from root to current node's parent #}

{% if ancestry_chain and ancestry_chain.ancestors %}
<ANCESTRY>
You are at depth {{ ancestry_chain.depth }} in the agent hierarchy.
Your lineage from root to parent:

{% for ancestor in ancestry_chain.ancestors %}
<ancestor depth="{{ ancestor.depth }}" role="{{ ancestor.role }}">
{{ ancestor.task_summary }}
</ancestor>
{% endfor %}
</ANCESTRY>
{% endif %}
