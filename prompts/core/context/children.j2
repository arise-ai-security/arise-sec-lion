{# Child outcomes template for ChildOutcomes #}
{# Renders structured results from child agents for parent consumption #}

{% if child_outcomes and child_outcomes.outcomes %}
<CHILD_OUTCOMES total="{{ child_outcomes.total_count }}" completed="{{ child_outcomes.completed_count }}" failed="{{ child_outcomes.failed_count }}">
Your children have completed their assigned tasks. Review their results below:

{% for outcome in child_outcomes.outcomes %}
<child id="{{ outcome.child_id }}" status="{{ outcome.status }}">
{% if outcome.task_summary %}
<task>{{ outcome.task_summary }}</task>
{% endif %}
<result>
{{ outcome.result_text }}
</result>
{% if outcome.artifacts %}
<artifacts>{{ outcome.artifacts | join(', ') }}</artifacts>
{% endif %}
{% if outcome.decisions %}
<decisions>{{ outcome.decisions | join(', ') }}</decisions>
{% endif %}
</child>
{% endfor %}
</CHILD_OUTCOMES>
{% endif %}
