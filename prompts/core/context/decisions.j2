{# Shared decisions template for SharedDecisions #}
{# Renders decisions from SharedExecutionContext #}

{% if shared_decisions and shared_decisions.decisions %}
<SHARED_DECISIONS>
Key decisions made during this execution (follow these for consistency):

{% for decision in shared_decisions.decisions %}
<decision key="{{ decision.key }}">
<value>{{ decision.value }}</value>
{% if decision.rationale %}
<rationale>{{ decision.rationale }}</rationale>
{% endif %}
</decision>
{% endfor %}
</SHARED_DECISIONS>
{% endif %}
