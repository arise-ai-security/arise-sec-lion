{# Source context template for extracted key information (Design Choice 6) #}
{# Provides workers with key information extracted from user prompt by BOSS #}
{# Design Choice 7: Includes CWE inference and fix patterns #}

{% if source_context and source_context.extraction_summary %}
<SOURCE_CONTEXT>
<summary>{{ source_context.extraction_summary }}</summary>

{# Bug/Issue Information #}
{% if source_context.bug_summary %}
<bug_summary>{{ source_context.bug_summary }}</bug_summary>
{% endif %}
{% if source_context.error_messages %}
<error_messages>
{% for msg in source_context.error_messages %}
  <error>{{ msg }}</error>
{% endfor %}
</error_messages>
{% endif %}
{% if source_context.reproduction_steps %}
<reproduction_steps>{{ source_context.reproduction_steps }}</reproduction_steps>
{% endif %}

{# Code References #}
{% if source_context.file_paths %}
<file_paths>
{% for path in source_context.file_paths %}
  <path>{{ path }}</path>
{% endfor %}
</file_paths>
{% endif %}
{% if source_context.commit_references %}
<commit_references>
{% for ref in source_context.commit_references %}
  <commit>{{ ref }}</commit>
{% endfor %}
</commit_references>
{% endif %}
{% if source_context.urls %}
<urls>
{% for url in source_context.urls %}
  <url>{{ url }}</url>
{% endfor %}
</urls>
{% endif %}

{# Environment Information #}
{% if source_context.environment %}
<environment>{{ source_context.environment }}</environment>
{% endif %}
{% if source_context.dependencies %}
<dependencies>
{% for dep in source_context.dependencies %}
  <dependency>{{ dep }}</dependency>
{% endfor %}
</dependencies>
{% endif %}
{% if source_context.key_facts %}
<key_facts>
{% for fact in source_context.key_facts %}
  <fact>{{ fact }}</fact>
{% endfor %}
</key_facts>
{% endif %}

{# Build/Execution Context (security-specific) #}
{% if source_context.dockerfile %}
<dockerfile>{{ source_context.dockerfile }}</dockerfile>
{% endif %}
{% if source_context.build_script %}
<build_script>{{ source_context.build_script }}</build_script>
{% endif %}
{% if source_context.work_dir %}
<work_dir>{{ source_context.work_dir }}</work_dir>
{% endif %}
{% if source_context.poc_command %}
<poc_command>{{ source_context.poc_command }}</poc_command>
{% endif %}
{% if source_context.sanitizer %}
<sanitizer>{{ source_context.sanitizer }}</sanitizer>
{% endif %}

{# Security Identifiers #}
{% if source_context.cve_id %}
<cve_id>{{ source_context.cve_id }}</cve_id>
{% endif %}
{% if source_context.repo_url %}
<repo_url>{{ source_context.repo_url }}</repo_url>
{% endif %}

{# Legacy reference fields #}
{% if source_context.key_references %}
<references>
{% for ref in source_context.key_references %}
  <ref>{{ ref }}</ref>
{% endfor %}
</references>
{% endif %}

{# Legacy detected_content flags (for backward compat) #}
<detected_content>
{% if source_context.has_bug_report %}  <bug_report>true</bug_report>
{% endif %}
{% if source_context.has_error_details %}  <error_details>true</error_details>
{% endif %}
{% if source_context.has_file_references %}  <file_references>true</file_references>
{% endif %}
{% if source_context.has_code_snippets %}  <code_snippets>true</code_snippets>
{% endif %}
</detected_content>

{# Legacy extracted_entities (for backward compat) #}
{% if source_context.extracted_entities %}
<extracted_entities>
{% for key, value in source_context.extracted_entities.items() %}
  <entity key="{{ key }}">{{ value }}</entity>
{% endfor %}
</extracted_entities>
{% endif %}

{# Design Choice 7: CWE Context Passing #}
{% if source_context.inferred_cwes %}
<SECURITY_CONTEXT>
<inferred_cwes>
{% for cwe in source_context.inferred_cwes %}
  <cwe id="{{ cwe }}">
{% if source_context.cwe_confidence and cwe in source_context.cwe_confidence %}
    <confidence>{{ source_context.cwe_confidence[cwe] }}</confidence>
{% endif %}
{% if source_context.cwe_reasoning and cwe in source_context.cwe_reasoning %}
    <reasoning>{{ source_context.cwe_reasoning[cwe] }}</reasoning>
{% endif %}
{% if source_context.fix_patterns and cwe in source_context.fix_patterns %}
    <fix_pattern>{{ source_context.fix_patterns[cwe] }}</fix_pattern>
{% endif %}
  </cwe>
{% endfor %}
</inferred_cwes>

{% if source_context.recommended_sanitizers %}
<recommended_sanitizers>
{% for sanitizer in source_context.recommended_sanitizers %}
  <sanitizer>{{ sanitizer }}</sanitizer>
{% endfor %}
</recommended_sanitizers>
{% endif %}
</SECURITY_CONTEXT>
{% endif %}
</SOURCE_CONTEXT>
{% endif %}
