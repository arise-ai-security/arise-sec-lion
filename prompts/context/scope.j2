{% endfor %}
{% endif %}
{% if scope.symbols %}
**Key symbols** (functions, classes, methods):
{% for s in scope.symbols %}
- {{ s }}
{% endfor %}
{% endif %}
{% if scope.search_hints %}
**Search hints** (keywords to grep for):
{% for h in scope.search_hints %}
- {{ h }}
{% endfor %}
{% endif %}
</scope>
