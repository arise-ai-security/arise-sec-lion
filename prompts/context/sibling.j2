{# Sibling context template for worker coordination #}
{% if parent_task %}
    <parent_context>
        Parent Task: {{ parent_task }}
    </parent_context>
{% endif %}

{% if siblings %}
    <sibling_tasks>
        You are one of {{ total_siblings }} sibling worker(s). {{ completed_count }} completed, {{ in_progress_count }}
        in progress.
        Workers execute left-to-right. Earlier workers' results are available to you.

        {% for sibling in siblings %}
            <task index="{{ sibling.sibling_index + 1 }}" status="{{ sibling.status }}">
                <description>{{ sibling.task_summary }}</description>
                {% if sibling.status == 'completed' and sibling.result_summary %}
                    <result>{{ sibling.result_summary }}</result>
                {% endif %}
            </task>
        {% endfor %}
    </sibling_tasks>
{% endif %}

{% if shared_decisions %}
    <shared_decisions>
        Key decisions made during this execution (follow these for consistency):
        {% for decision in shared_decisions %}
            <decision key="{{ decision.key }}">
                <value>{{ decision.value }}</value>
                <rationale>{{ decision.rationale }}</rationale>
            </decision>
        {% endfor %}
    </shared_decisions>
{% endif %}

{% if has_downstream_siblings %}
    <context_update_instructions>
        If you make important decisions or produce outputs that sibling workers should know about, include at the END of
        your response:

        <context-update>
            <decision key="your_decision_key">
                <value>The decision you made</value>
                <rationale>Why you made this decision</rationale>
            </decision>
            <output key="artifact_name">Brief description of what you created</output>
        </context-update>

        This is optional. Only include if you have meaningful context to share.
    </context_update_instructions>
{% endif %}
