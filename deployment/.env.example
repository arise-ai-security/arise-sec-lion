# Arise Multi-Agent System
# Copy to .env and fill in your values: cp .env.example .env
#
# Non-secret configuration lives in config/config.yaml
# Only SECRETS and Docker overrides belong here

# =============================================================================
# SECRETS (required)
# =============================================================================

# PostgreSQL password (for container initialization)
POSTGRES_PASSWORD=your_password_here

# Application database access (must match POSTGRES_PASSWORD)
ARISE_INFRA_POSTGRES_PASSWORD=your_password_here

# LLM API Keys (set the ones you need)
OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# =============================================================================
# Docker Environment Overrides
# =============================================================================
# In Docker, use service name "db" instead of "localhost"
ARISE_INFRA_POSTGRES_HOST=db
