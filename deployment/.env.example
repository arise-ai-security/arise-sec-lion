# =============================================================================
# Arise Multi-Agent System - Environment Secrets
# =============================================================================
# This file contains SECRETS ONLY (API keys, passwords, credentials).
# Configuration/hyperparameters are in config/default.yaml
#
# Copy this file to .env:  cp .env.example .env

# -----------------------------------------------------------------------------
# Database Credentials
# -----------------------------------------------------------------------------
POSTGRES_USER=arise
POSTGRES_PASSWORD=arise_secret
POSTGRES_DB=arise_events

# -----------------------------------------------------------------------------
# LLM Provider API Keys
# -----------------------------------------------------------------------------
# OpenAI (REQUIRED for default configuration)
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic (optional - only if using worker_tool_type: claude_code in config)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
