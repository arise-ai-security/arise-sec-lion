# Arise Multi-Agent System
# Copy to .env and fill in your values: cp .env.example .env
#
# Application config lives in config/config.yaml
# Only SECRETS belong here

# =============================================================================
# SECRETS (required)
# =============================================================================

# Database password
POSTGRES_PASSWORD=your_secure_password_here

# LLM Provider API Keys (set the ones you need)
OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# =============================================================================
# Docker Overrides (optional)
# =============================================================================

# Use container service name instead of localhost
POSTGRES_HOST=db

# =============================================================================
# Environment Phase (optional, default: development)
# =============================================================================

# ARISE_ENV=development  # or: production
