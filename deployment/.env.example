# Secrets (required)
POSTGRES_PASSWORD=your_secure_password
OPENAI_API_KEY=sk-your-openai-key

# Optional: Claude Code uses `claude login` for local auth
# Only needed if running in Docker without local auth
# ANTHROPIC_API_KEY=sk-ant-your-key

# Optional: OpenRouter (https://openrouter.ai). One key gives unified access to
# 100+ models from many providers and survives provider-specific rate limits.
# When ARISE_LLM_GATEWAY=openrouter, the OpenRouterAdapter routes all
# orchestrator LLM calls through this endpoint; model strings keep their
# `openai/...`, `anthropic/...`, etc. prefixes.
# OPENROUTER_API_KEY=sk-or-v1-your-key

# Optional: Ollama Cloud (https://ollama.com). Generate a key at
# https://ollama.com/settings/keys, then set the model in config.yaml to
# e.g. `ollama_chat/gpt-oss:120b`. LiteLLM reads these env vars directly,
# so you can also leave api_base/base_url unset in YAML.
# OLLAMA_API_KEY=
# OLLAMA_API_BASE=https://ollama.com

# Docker overrides (optional)
POSTGRES_HOST=db
# ARISE_ENV=production
