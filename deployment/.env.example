# =============================================================================
# Arise Multi-Agent System - Environment Configuration
# =============================================================================
# Copy this file to .env:  cp .env.example .env

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=arise
POSTGRES_PASSWORD=arise_secret
POSTGRES_DB=arise_events
POSTGRES_PORT=5432

# Connection string (auto-constructed in docker-compose, but useful for local dev)
# DATABASE_URL=postgresql://arise:arise_secret@localhost:5432/arise_events

# -----------------------------------------------------------------------------
# LLM Provider Configuration (choose one)
# -----------------------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic (optional)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Azure OpenAI (optional)
# AZURE_API_KEY=your-azure-key
# AZURE_API_BASE=https://your-resource.openai.azure.com/

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Default LLM model for agents
LLM_MODEL=gpt-4o-mini

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
