# Example Environment Variables for Arise Multi-Agent System
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================================================
# Infrastructure Secrets (DO NOT COMMIT THESE VALUES!)
# ============================================================================

# PostgreSQL
ARISE_INFRA_POSTGRES_PASSWORD=your-postgres-password-here

# ============================================================================
# LLM API Keys (LiteLLM automatically reads these based on the model)
# ============================================================================
# LiteLLM automatically picks the right API key based on the model you specify.
# Only set the API key(s) for the provider(s) you're using.
#
# How it works:
# - Set llm_model in config YAML (e.g., "gpt-4o", "claude-3-5-sonnet-20241022")
# - LiteLLM reads the corresponding API key from the environment
#
# OpenAI (models: gpt-4, gpt-4o, gpt-4o-mini, gpt-3.5-turbo, etc.)
OPENAI_API_KEY=sk-your-openai-api-key-here
#
# Anthropic Claude (models: claude-3-5-sonnet-20241022, claude-3-opus-20240229, etc.)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
#
# Google Gemini (models: gemini-pro, gemini-1.5-pro, gemini-1.5-flash, etc.)
GEMINI_API_KEY=your-gemini-api-key-here
# Alternative: GOOGLE_API_KEY=your-google-api-key-here
